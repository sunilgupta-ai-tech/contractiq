# =============================================================================
# ContractIQ — environment configuration
# Copy to `.env` for local development. NEVER commit `.env`.
# In staging/production these values come from AWS Secrets Manager / SSM,
# injected into ECS task definitions — not from a file.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development            # development | staging | production
APP_NAME=ContractIQ
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=false                 # true in staging/production (CloudWatch-friendly)
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50

# --- PostgreSQL (local: docker service `postgres`; prod: AWS RDS) -------------
POSTGRES_USER=contractiq
POSTGRES_PASSWORD=contractiq_dev_password
POSTGRES_DB=contractiq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://contractiq:contractiq_dev_password@postgres:5432/contractiq
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (local: docker service `redis`; prod: AWS ElastiCache) -------------
REDIS_URL=redis://redis:6379/0

# --- Qdrant (local: docker service `qdrant`; prod: Qdrant Cloud / self-hosted) -
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=contract_chunks
EMBEDDING_DIMENSION=768

# --- Object storage (local filesystem in dev, S3 in prod) ---------------------
STORAGE_BACKEND=local          # local | s3
LOCAL_STORAGE_PATH=/data/storage
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM providers (backend only — never exposed to the browser) --------------
LLM_PROVIDER=ollama            # ollama | gemini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- Auth ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Observability ------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Frontend (public — safe for the browser) ---------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_DEMO_DATA=true
