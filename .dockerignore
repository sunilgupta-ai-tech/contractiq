# Root build context is used by workers/Dockerfile (backend/requirements.txt,
# backend/app, workers/app) and infrastructure/render/Dockerfile (also
# backend/migrations, backend/alembic.ini and its start script).

# Secrets
.env
.env.*

# VCS / tooling
.git
.github
.gstack
.vscode
.idea
**/.DS_Store

# Python caches
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.venv

# Not part of the worker image
frontend
infrastructure
!infrastructure/render/start.sh
docs
backups
data
storage
eval-reports
**/tests
